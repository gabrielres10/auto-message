# =============================================================================
# Database — NeonDB PostgreSQL
# Get your connection string from: https://console.neon.tech
# =============================================================================
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/auto-message?sslmode=require"

# =============================================================================
# Redis — local Docker instance by default
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# NextAuth
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-openssl-rand-base64-32"

# =============================================================================
# OAuth Providers — add the ones you want to enable
# =============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# App
# =============================================================================
NODE_ENV="development"
LOG_LEVEL="info"

# =============================================================================
# Worker — WhatsApp session owner
# The DB User.id of the account whose WhatsAppSession row the worker will manage.
#
# How to find it:
#   Option 1 — Prisma Studio:  npm run db:studio  → open User table → copy id
#   Option 2 — one-liner:
#     node -e "const {PrismaClient}=require('@prisma/client');const db=new PrismaClient();db.user.findMany({select:{id:true,email:true}}).then(u=>{console.log(JSON.stringify(u));db.\$disconnect()})"
#
# =============================================================================
WORKER_USER_ID="paste-user-id-here"
